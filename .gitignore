.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ── Pruebas y análisis ──
/coverage
.nyc_output

# ── Despliegue ──
.vercel
*.env

# ── IDE y OS ──
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Python (scripts de herramientas) ──
__pycache__/
*.pyc

# ── Misc ──
.turbo/
*.tsbuildinfo
