# ── Dependencias ──
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js build output ──
/.next/
/out/
/build
next-env.d.ts
tsconfig.tsbuildinfo

# ── Prisma ──
prisma/*.db
prisma/*.db-journal

# ── Variables de entorno ──
