{
  "name": "prototype-menu-whatsapp",
  "version": "0.1.0",
  "private": true,
  "description": "Prototipo genérico: catálogo de productos con pedidos por WhatsApp.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build && npm run audit:bundle",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project=unit",
    "test:integracion": "vitest run --project=integracion",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:migrate": "docker exec -i prototype-db-test psql -U postgres -d prototype_test -v ON_ERROR_STOP=1 -f - < tests/infra/roles-y-auth-stub.sql && DATABASE_URL=\"${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:55433/prototype_test}\" DIRECT_DATABASE_URL=\"${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:55433/prototype_test}\" prisma migrate deploy",
    "db:test:down": "docker compose -f docker-compose.test.yml down",
    "test:ui": "vitest run --project=ui",
    "test:coverage": "vitest run --coverage",
    "test:ci": "npm run test:unit && npm run test:ui && npm run test:integracion",
    "audit:bundle": "node scripts/auditar-bundle.mjs",
    "audit:deps": "npm audit --omit=dev",
    "verify:actions": "node scripts/verificar-acciones.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "menu:exportar": "node scripts/exportar-menu.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:estado": "prisma migrate status",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "demo:datos": "tsx --conditions=react-server scripts/sembrar-demo-mock.ts",
    "demo:sondeo": "tsx --conditions=react-server scripts/sondear-datos.ts"
  },
  "prisma": {
    "seed": "tsx --conditions=react-server prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "@vitest/coverage-v8": "^5",
    "dotenv": "^18.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "^29.1.1",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.7",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5"
  }
}